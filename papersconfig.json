THIS IS A COPY OF THE FILE ACTUALLY USED!
for first setup copy it to ~/.local/config and then change two paths:
bibtex
filedir

{
  "absolute_paths": false,
  "backup_files": false,
  "bibtex": "~/papers.bib",
  "editor": null,
  "filesdir": "~/docs/papers",
  "git": false,
  "gitdir": "/do/not/use/backup",
  "gitlfs": false,
  "keyformat": {
    "author_num": 1,
    "author_sep": "_",
    "template": "{author}{year}",
    "title_length": 100,
    "title_sep": "-",
    "title_word_num": 100,
    "title_word_size": 1,
    "unknown_strict": false,
    "unknown_template": "{doi}"
  },
  "local": false,
  "nameformat": {
    "author_num": 2,
    "author_sep": "_",
    "template": "{authorX}_{year}_{title}",
    "title_length": 100,
    "title_sep": "-",
    "title_word_num": 5,
    "title_word_size": 4,
    "unknown_strict": false,
    "unknown_template": "unknown_{doi_or_id}"
  }
}
